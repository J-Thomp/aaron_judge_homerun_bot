# Required Discord configuration
BOT_TOKEN=your_discord_bot_token
CHANNEL_ID=123456789012345678

# Optional comma-separated allowlists
ADMIN_USER_IDS=
ALLOWED_GUILD_IDS=

# Optional profile and Python configuration
BOT_USERNAME=
PYTHON_BIN=
STATE_PATH=

# Bounded HTTP and background-work settings
HTTP_TIMEOUT_MS=10000
HTTP_RETRIES=3
ENRICHMENT_CONCURRENCY=3
ANALYSIS_CONCURRENCY=2
BACKFILL_BATCH_SIZE=3
BACKFILL_COOLDOWN_MS=60000
POLL_INTERVAL_MS=240000
OFFSEASON_POLL_INTERVAL_MS=21600000
POLL_JITTER_MS=30000
READY_TIMEOUT_MS=60000
